{
  "name": "academic-report-automation",
  "version": "1.0.0",
  "description": "Academic report automation toolkit with templates, validation helpers and visual rendering utilities.",
  "private": false,
  "scripts": {
    "visual:help": "python3 tools/visual_builder.py --help",
    "build:sample:html": "python3 tools/build_report.py examples/sample_report.md --html outputs/sample_report.html",
    "build:sample:pdf": "python3 tools/build_report.py examples/sample_report.md --pdf outputs/sample_report.pdf"
  },
  "keywords": [
    "academic-report",
    "automation",
    "python",
    "weasyprint",
    "markdown",
    "visualization"
  ],
  "author": "Alejandro Padilla",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.14.0",
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "echarts": "^6.0.0"
  }
}
