%% To-be intake flow, 2026-10-01. Reflects skills/academic-report-flow (replaces intake-flow-current.mmd).
flowchart TD
    REQ["User request<br/>e.g. 'solve exercise 1.5'"] --> ENTRY["Single entry: academic-report-flow<br/>(triggers include exercise, homework, APE, AA)"]
    ENTRY --> WF{"Work-folder flow available?<br/>Folder for this document exists?"}
    WF -->|"new request"| MK["Create reports/&lt;slug&gt;/<br/>(slug derived, never asked;<br/>numeric suffix if taken by another document)"]
    MK --> STATUS
    WF -->|"existing folder (resume)"| STATUS["doc_status.py on reports/&lt;slug&gt;/<br/>empty folder = next: intake<br/>load only the phase reference named by 'next'"]
    WF -->|"unavailable: no content root or<br/>user asks for a one-off document"| FULL
    STATUS -->|"next = intake"| LOADI["Load references/intake.md<br/>prompt / memory = proposal, never confirmation"]

    LOADI --> CF0["Content-first intake<br/>(default under doc_status)"]
    CF0 --> SIG{"Request names an academic<br/>assignment? (subject, teacher, APE, AA,<br/>exercise, homework, guide, rubric)"}
    SIG -->|yes| ROUTE["Record route: academic<br/>state it in the intake summary"]
    SIG -->|"absent or conflicting"| ASKR["Ask the route"]
    ROUTE --> STU
    ASKR --> STU
    STU{"Student saved by the user<br/>as permanent?"}
    STU -->|yes| STUOK["Record as confirmed, no question"]
    STU -->|no| STUSUG["Single-choice suggestion<br/>(Alejandro Padilla), never auto-filled"]
    STUOK --> TITLE
    STUSUG --> TITLE
    TITLE{"Title is a real title?<br/>(free-text sanity check)"}
    TITLE -->|"commentary, question or complaint"| TCONF["Show cleaned candidate,<br/>ask one-line confirmation"]
    TITLE -->|yes| GUIDE
    TCONF --> GUIDE
    GUIDE["Always request guide, rubric and<br/>teacher explanation if not supplied"]
    GUIDE --> BATCH["ONE compact question batch<br/>(never a second round unless an answer is unusable)"]
    BATCH --> CFSTOP(["STOP and wait for answers"])
    CFSTOP --> REC

    FULL["Standalone full route (intake.md)<br/>no document type is inferred"] --> FC["Confirmations unchanged:<br/>C1 type, C2 audience + purpose, C3 template + identity,<br/>structure, C4 delivery format, C5 visual direction"]
    FC --> FSTOP(["STOP and wait for answers"])
    FSTOP --> REC

    REC["Write report.yml<br/>audience / purpose / template / cover derived, never asked"] --> IDONE{"route known AND<br/>title + student real?"}
    IDONE -->|no| PEND["intake = pending<br/>(unknown route = blocked)"] --> LOADI
    IDONE -->|yes| RES["research: >= 5 IEEE sources<br/>(research-workflow)"]
    RES --> PLAN["plan: rubric.yml"] --> DRAFT["draft: body.md"]
    DRAFT --> APPR{"Human gate 1: approval<br/>approval.yml"}
    APPR -->|body.md edited| DRAFT
    APPR -->|approved| VER["verify: content-check.yml"]
    VER --> FMT["format: APE / AA / libre<br/>+ delivery format PDF / DOCX"]
    FMT --> GEN["generate"] --> VAL["validate: validation.yml"]
    VAL --> REV{"Human gate 2: final review<br/>final-review.yml"}
    REV --> DEL["deliver: versioned publication"] --> DONE([done])

    classDef stop fill:#fff4c2,stroke:#a80,color:#000
    class CFSTOP,FSTOP,APPR,REV stop
