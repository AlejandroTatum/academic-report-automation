%% Flujo vigente de academic-report-flow (acordado e implementado 2026-10-01): tres decisiones humanas;
%% cada regla de calidad la exige una herramienta antes de la siguiente decisión humana.
flowchart TD
    REQ["Pedido<br/>p. ej. 'resolver el ejercicio 1.5'"] --> WF{"¿Existe carpeta de trabajo<br/>para este documento?"}
    WF -->|no| NEW["Crear reports/&lt;slug&gt;/"]
    WF -->|en curso| RES["Retomar: siguiente paso de doc_status"]
    WF -->|ya entregado| ASKV{{"Preguntar una vez: versión nueva<br/>o retomar (nunca sobrescribir)"}}
    ASKV --> NEW
    NEW --> D1
    RES --> STATUS

    D1[/"DECISIÓN 1 - datos (una sola tanda)<br/>título + guía, rúbrica y explicación del docente<br/>ruta y estudiante guardado se deducen; solo se pregunta lo que falta"/]
    D1 --> STATUS(("doc_status<br/>máquina de estados"))

    STATUS --> SRC["Fuentes<br/>respeta min_sources, verify_sources"]
    SRC --> PLAN["Plan<br/>rúbrica del docente o, si no hay, pedidos de la guía"]
    PLAN --> DRAFT["Borrador body.md<br/>código ejecutado, números verificados"]
    DRAFT --> G1{"CONTROL del borrador<br/>secciones con #, subíndices en fórmula,<br/>citas, chequeos de la rúbrica"}
    G1 -->|falla| DRAFT

    G1 -->|pasa| D2[/"DECISIÓN 2 - una sola tanda<br/>aprobar body.md + formato AA/APE/libre<br/>+ PDF/DOCX + datos faltantes"/]
    D2 -->|pedido de cambios| DRAFT

    D2 -->|aprobado| G2{"CONTROL de verificación<br/>2 jueces independientes<br/>(los lanza el orquestador)"}
    G2 -->|flojo/falta| DRAFT
    G2 -->|cumple| GEN["Generar PDF/DOCX"]
    GEN --> G3{"CONTROL de validación<br/>validate_report + auditoría visual<br/>+ revisión página por página = VISUAL_PASS"}
    G3 -->|defecto del contenido| DRAFT
    G3 -->|defecto de herramienta| STOP(["Detenerse y reportar<br/>(se arregla la herramienta, nunca el borrador aprobado a escondidas)"])

    G3 -->|pasa| D3[/"DECISIÓN 3 - OK final sobre el PDF exacto"/]
    D3 -->|cambios| DRAFT
    D3 -->|OK| DEL["Publicar vNNN<br/>~/Documents/&lt;categoría&gt;/&lt;materia&gt;/&lt;slug&gt;/<br/>READY_TO_SUBMIT"]
    DEL --> DONE([fin])

    classDef human fill:#fff4c2,stroke:#a80,color:#000
    classDef gate fill:#e3f2ff,stroke:#2a6fb0,color:#000
    classDef stop fill:#ffe0e0,stroke:#c00,color:#000
    class D1,D2,D3,ASKV human
    class G1,G2,G3 gate
    class STOP stop
